#! /usr/bin/env bash

# directory=($(find /home/a6dg2uv/a6dg2uv/mydocs/note/source -type d))
# directory=(/home/a6dg2uv/a6dg2uv/mydocs/note/source/*)
file_extension=".rst"

# 创建一个数组，然后把找到的目录重定向到while的标准输入,然后再把目录储存到数组里，其实就是把路径储存到数组里
directories=()
while IFS= read -r -d '' dir; do
    directories+=("$dir")
done < <(find /home/a6dg2uv/a6dg2uv/mydocs/note/source* -type d -print0)

# a+=$(find "$target_directory" -type d)
# echo "$a"

# printf '%s\n' "${directories[@]}"

#这一段代码本来是想进入每一个目录下寻找特定类型的文件，但是后面发现其实find目录是可以遍历当前目录下包括子目录，也就不要这
#一步了，反而如果多了这一步，那么输出的结果就变成里两次，就会有点奇怪
# for dir in "${directories[@]}"; do
#     # mapfile -t file_array < <(find "$dir" -type f -name "*$file_extension" -print)
#     # files_array+=("${file_array[@]}")
#     # echo "$dir"
#     while IFS= read -r -d '' file; do
#         files+=("$file")
#         # echo "$file"
#     done < <(find "$dir" -type f -name "*$file_extension" -print0)
#     # echo "$dir"
# done

# ***************************************************************************************************************
# 这段 Bash 脚本使用了 `find` 命令来搜索指定目录下满足条件的文件，并将结果逐行读取到循环中处理。让我逐步解释每一部分：
#
# 1. `IFS= read -r -d '' file;`：
#    - `IFS=`：设置输入字段分隔符为空，这样可以确保读取到的整行内容都被存储在变量中。
#    - `read -r -d '' file;`：`read` 命令用于从标准输入中读取一行，并将其存储到变量 `file` 中。
#      - `-r`：禁止对反斜杠的转义，确保反斜杠被当作普通字符处理。
#      - `-d ''`：设置行定界符为空，这意味着 `read` 命令会读取整行直到遇到空字符，这样可以处理包含空格的文件名。
#
# 2. `do`：循环开始。
#
# 3. `files+=("$file")`：将每次循环读取到的文件名添加到名为 `files` 的数组中。
#
# 4. `done`：循环结束。
#
# 5. `< <(find /home/a6dg2uv/a6dg2uv/mydocs/note/source -type f -name "*$file_extension" -print0)`：
#    - `< <(...)`：将命令的输出重定向到循环的标准输入。
#    - `find /home/a6dg2uv/a6dg2uv/mydocs/note/source -type f -name "*$file_extension" -print0`：`find` 命令用于搜索指定目录下满足条件的文件。
#      - `/home/a6dg2uv/a6dg2uv/mydocs/note/source`：要搜索的目录路径。
#      - `-type f`：只搜索文件，不包括目录。
#      - `-name "*$file_extension"`：指定文件名匹配模式，`$file_extension` 是一个变量，用于指定文件名的后缀。
#      - `-print0`：以空字符作为文件名的分隔符输出结果，这样可以确保正确处理包含空格或特殊字符的文件名。
#
# 整体来说，这段脚本的作用是搜索指定目录下满足条件的文件，并将它们的路径存储在名为 `files` 的数组中。
# ***************************************************************************************************************

while IFS= read -r -d '' file; do
    files+=("$file")
done < <(find /home/a6dg2uv/a6dg2uv/mydocs/note/source -type f -name "*$file_extension" -print0)

# printf '%s\n' "${files[@]}"

# for循环将路径列表进行basename获取最终目录或者文件名字，然后储存起来，作为一个数组
for path in "${files[@]}"; do
    basename=$(basename "$path")
    # echo "$basename"
    dir=$(dirname "$path")
    dirname=$(echo "$dir" | awk -F '/source/' '{print $2}')
    #dirname=$(basename "$dir")
    # for f_dir in "$basename"; do
    #     dirname+=($(basename "$dir"))
    #     fullname+=("${dirname[@]}"/"$f_dir")
    #
    # done

    filename+=("$dirname"/"$basename")
done

# 这里的这些是测试各个数组内的内容是否是正确的,这里不能用echo来显示数组内容,echo只能显示数组里第一个元素
# printf '%s\n' "${basename[@]}"
# printf '%s\n' "${dirname[@]}"
# printf '%s\n' "${fullname[@]}"
# printf '%s\n' "${filename[@]}"
#


# whiptail参数需要两个数组来组成一个选项,这里就用j作为其中一个,当作序号
j=0
for file in "${filename[@]}"; do
    j=$((j+1))
    # echo "$basename"
    fullname+=("$file" "$j")
done

# 将whiptail结果赋值到menu_choice
# whiptail 后面那3个数字的意思是“高，宽，可以显示多少列选项”
menu_choice=$(dialog  --backtitle "文档选择" --title "文档选择" --menu "自己选吧:" 28 80 18 \
"${fullname[@]}" 3>&1 1>&2 2>&3
)

# 将上一个命令的返回值进行存储判断，来进行下一部操作
exitstatus=$?

if [ $exitstatus = 0 ]; then
    # 判断是不是有rst文件直接在source目录下
    if [[ "$menu_choice" == *"source/"* ]]; then
        vim /home/a6dg2uv/a6dg2uv/mydocs/note/"$menu_choice"
    else
        vim /home/a6dg2uv/a6dg2uv/mydocs/note/source/"$menu_choice"
    fi
else
    echo "You chose Cancel."
    echo "你选择了取消"
fi

