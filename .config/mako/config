# ~/.config/mako/config (verified syntax)
font=Noto 12
width=550
height=1000
margin=10
padding=10,5
border-size=2
border-radius=0
#anchor=top-left
anchor=top-right

background-color=#1f2032
text-color=#b6c0db
border-color=#89b4fa

[urgency=low]
default-timeout=5000
background-color=#1f2032
text-color=#b6c0db
border-color=#a0d0a0
# green

[urgency=normal]
default-timeout=10000
background-color=#1f2032
text-color=#b6c0db
border-color=#89b4fa
# cyan

[urgency=critical]
default-timeout=15000
font=Noto Bold 12
background-color=#1f2032
text-color=#b6c0db
border-color=#f08080
# red
