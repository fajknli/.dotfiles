map ,
# source $XDG_CONFIG_HOME/lf/locate
# 导航文件
source ~/.config/lf/locate

# 单个确认删除
map <delete> delete
# 多选改名
map R bulk-rename
# 删除目标
map D trash
# 创建目录
map a :push %mkdir<space>
# 创建文件
map t :push %touch<space>
#map n :push $nvim<space>
#map n $nvim $f

#map <enter> shell
# 自动文件的打开方式
map <enter> open

# show the result of execution of previous commands
# 查看lf里执行的命令在终端的输出
map ` !true

# execute current file (must be executable)
# 执行选中的可执行文件
#               :  read (default)  builtin/custom command
#               $  shell           shell command
#               %  shell-pipe      shell command running with the UI
#               !  shell-wait      shell command waiting for a key press
#               &  shell-async     shell command running asynchronously
# x，lf后台执行，不显示输出结果。X,停留输出终端，显示结果
map x $$f
map X !$f

# dedicated keys for file opener actions
#map o &mimeopen $f
#map O $mimeopen --ask $f

#切换文件权限
map <c-p> permisson

# extract,解压缩目标,单个 
map <c-e> extract

# 复制当前路径
map .pwd cp_path

map <c-t> nvim-tabs

# 按 ctrl+y (yank/collect) 收集当前目录
map <c-y> collect

# 刷新
map <c-r> reload

# 打包相关快捷键
# map t tar       # 打包为 tar.gz
# map T tarxz     # 打包为 tar.xz (更高压缩)
# map z zip       # 打包为 zip
# map Z sevenzip  # 打包为 7z (最高压缩)
