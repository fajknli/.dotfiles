map ,
# source $XDG_CONFIG_HOME/lf/locate
source ~/.config/lf/locate

map <delete> delete
map R bulk-rename
map D trash
map a :push %mkdir<space>

#map <enter> shell
map <enter> open

# show the result of execution of previous commands
map ` !true

# execute current file (must be executable)
map x $$f
map X !$f

# dedicated keys for file opener actions
#map o &mimeopen $f
#map O $mimeopen --ask $f

#map <c-p> premission
map <c-p> permisson
