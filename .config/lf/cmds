# 收集选中的文件/目录内容（优化版）
cmd collect &{{
    if [ -z "$fx" ]; then
        lf -remote "send $id echo '没有选中任何文件，请先选中文件'"
        exit
    fi
    
    current_dir="$PWD"
    tmp_file="/tmp/lf_collect_$$.tmp"
    > "$tmp_file"
    
    # 收集所有文件（处理目录递归）
    for item in $fx; do
        if [ -d "$item" ]; then
            find "$item" -type f 2>/dev/null | grep -vE '/\.git/|/node_modules/|/\.cache/|/target/|/dist/|/build/|\.log$|\.tmp$|\.swp$|~$' >> "$tmp_file"
        else
            echo "$item" >> "$tmp_file"
        fi
    done
    
    selected_files=$(sort -u "$tmp_file" | grep -v '^$')
    rm -f "$tmp_file"
    
    if [ -z "$selected_files" ]; then
        lf -remote "send $id echo '选中的目录中没有文本文件'"
        exit
    fi
    
    # 构建输出内容
    content=""
    content+="========================================\n"
    content+="[目录] $current_dir\n"
    content+="[时间] $(date '+%Y-%m-%d %H:%M:%S') | [系统] $(uname -o) | [用户] $(whoami)@$(hostname)\n"
    content+="[说明] 以下为选中的文件，请分析并提供建议\n"
    content+="========================================\n\n"
    
    content+="[选中的文件]\n"
    content+="----------------------------------------\n"
    while read -r file; do
        content+="  ${file#$current_dir/}\n"
    done <<< "$selected_files"
    content+="\n========================================\n\n"
    
    content+="[文件内容]\n"
    content+="========================================\n\n"
    
    file_count=0
    skip_count=0
    skip_reasons=""
    
    while read -r file; do
        [ -f "$file" ] || continue
        
        rel_path="${file#$current_dir/}"
        size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null)
        size_human=$(numfmt --to=iec "$size" 2>/dev/null || echo "${size}B")
        
        if [ "$size" -gt 1048576 ]; then
            skip_count=$((skip_count + 1))
            skip_reasons+="  - $rel_path (超过1MB: $size_human)\n"
            continue
        fi
        
        file_type="$(file -b "$file" 2>/dev/null)"
        
        if echo "$file_type" | grep -qiE 'text|empty|ascii|utf-?8|json|yaml|xml|toml|kdl|ini|conf|script|source|markdown|config|data'; then
            ext="${rel_path##*.}"
            [ "$ext" = "$rel_path" ] && ext="txt"
            
            content+="-- $rel_path -- $size_human -- $file_type --\n"
            content+="\`\`\`$ext\n"
            content+="$(cat "$file" 2>/dev/null)\n"
            content+="\`\`\`\n\n"
            file_count=$((file_count + 1))
        else
            skip_count=$((skip_count + 1))
            skip_reasons+="  - $rel_path (二进制: $file_type)\n"
        fi
    done <<< "$selected_files"
    
    content+="========================================\n"
    content+="[统计] 已收集: $file_count 个文件, 已跳过: $skip_count 个文件\n"
    
    if [ -n "$skip_reasons" ]; then
        content+="\n[跳过详情]\n$skip_reasons"
    fi
    
    content+="========================================\n"
    
    echo -e "$content" | wl-copy 2>/dev/null
    if [ $? -eq 0 ]; then
        lf -remote "send $id echo \"已复制 $file_count 个选中文件的内容\""
    else
        lf -remote "send $id echo \"复制失败\""
    fi
}}
