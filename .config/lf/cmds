# define a custom 'delete' command
cmd delete ${{
    set -f
    printf "$fx\n"
    printf "delete?[y/n]"
    read ans
    [ "$ans" = "y" ] && rm -rf $fx
}}

# move current file or selected files to trash folder
cmd trash ${{
    mkdir -p "$HOME/.trash" 2>/dev/null
    if [ -n "$fx" ]; then
        for item in $fx; do
            mv -- "$item" "$HOME/.trash/" 2>/dev/null
        done
        lf -remote "send $id echo \"已移动到回收站\""
    else
        lf -remote "send $id echo \"没有选中任何文件\""
    fi
}}

# define a custom 'open' command
cmd open &{{
    case $(file --mime-type -Lb $f) in
        text/*)
            nvim -p $fx
            ;;
        image/*)
            imv $f > /dev/null 2>&1 &
            ;;
        application/pdf)
            zathura $f > /dev/null 2>&1 &
            ;;
        video/*|audio/*)
            mpv $f > /dev/null 2>&1 &
            ;;
        *)
            xdg-open "$f" > /dev/null 2>&1 &
            ;;
    esac
}}

# extract the current file with the right command
cmd extract ${{
    set -f
    case $f in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) 
            tar -xjvf "$f" ;;
        *.tar.gz|*.tgz) 
            tar -xzvf "$f" ;;
        *.tar.xz|*.txz) 
            tar -xJvf "$f" ;;
        *.tar.zst|*.tzst) 
            tar --zstd -xvf "$f" ;;
        *.tar) 
            tar -xvf "$f" ;;
        *.zip) 
            unzip "$f" ;;
        *.rar) 
            unrar x "$f" ;;
        *.7z) 
            7z x "$f" ;;
        *.gz) 
            gunzip -k "$f" ;;
        *.bz2) 
            bunzip2 -k "$f" ;;
        *.xz) 
            unxz -k "$f" ;;
        *.zst) 
            unzstd -k "$f" ;;
        *.deb) 
            mkdir -p "${f%.deb}" && ar x "$f" --output="${f%.deb}" ;;
        *.rpm) 
            mkdir -p "${f%.rpm}" && rpm2cpio "$f" | cpio -idmv -D "${f%.rpm}" ;;
        *) 
            echo "不支持的文件格式: $f" ;;
    esac
    lf -remote "send $id reload"
}}

# 打包函数复用
cmd tar ${{
    current_dir="$PWD"
    if [ -n "$fx" ]; then
        rel_files=""
        for file in $fx; do
            rel_file="${file#$current_dir/}"
            [ "$rel_file" = "$file" ] && rel_file=$(basename "$file")
            rel_files="$rel_files \"$rel_file\""
        done
        first_file="${fx%% *}"
        basename=$(basename "$first_file")
        base="${basename%.*}"
        [ "$base" = "$basename" ] && base="$basename"
        [ -z "$base" ] && base="archive"
        cd "$current_dir"
        eval tar czf "$base.tar.gz" $rel_files
        lf -remote "send $id echo \"已打包: $base.tar.gz\""
    else
        dirname=$(basename "$PWD")
        tar czf "$dirname.tar.gz" -- * 2>/dev/null
        lf -remote "send $id echo \"已打包整个目录: $dirname.tar.gz\""
    fi
}}

