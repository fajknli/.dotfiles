source ~/.config/lf/cmds
source ~/.config/lf/maps

# previewer
#set preview true
#set previewer chafa -f symbols {}
#set previewer ~/.config/lf/filepreviewer
set previewer ~/.local/bin/filepreviewer

# interpreter for shell commands
set shell sh
set relativenumber true
set icons
set hidden true

# pane width
set ratios 1:2:4

# set directory at first and dotfile at last
set dirfirst true
# 反向
#set reverse true

set ifs "\n"

# leave some space at the top and the bottom of the screen
#set scrolloff 10

set cursorpreviewfmt "\033[7;2m"
#set cursorpreviewfmt "\033[1;30;44m"
#set cursoractivefmt "\033[1;30;46m"
#set cursorparentfmt "\033[1;30;44m"
