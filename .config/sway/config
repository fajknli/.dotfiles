# Sway 配置文件
# ========================
# 该配置文件用于设置 Sway 窗口管理器及其相关应用的行为和外观。

# 设置缩放比例（例如 1.0 表示不缩放，1.5 适用于 2K HiDPI，2.0 适用于 4K）
set $env GDK_SCALE=1
set $env GDK_DPI_SCALE=0.5   # 可选，进一步微调
set $env QT_SCALE_FACTOR=1   # Qt 程序缩放
#set $env MOZ_ENABLE_WAYLAND=1  # 确保 Firefox 使用 Wayland 后端

output ePD-1 scale 1



# 锁屏和休眠设置
exec swayidle -w \
	timeout 1800 'swaylock -f -c 151622' \
	timeout 1805 'swaymsg "output * dpms off"' \
	resume 'swaymsg "output * dpms on"'

exec_always swaymsg 'input type:touchpad events disabled'

# 启动程序
exec_always fcitx5
exec_always pot
exec_always wl-paste --type text --watch cliphist store
exec_always wl-paste --type image --watch cliphist store
#exec_always wlsunset -l 28.23 -L 112.97 -t 4000 -T 6500



### Variables
# 修改为 Windows 键作为默认 Mod 键
set $mod Mod4  
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu fuzzel

# 字体设置
font pango: 0xProto Nerd Font Mono 10

# Gaps 设置
smart_borders on
smart_gaps on

# boeder 设置
default_border pixel 1
default_floating_border pixel 1
titlebar_border_thickness 0

client.focused  #607bc3 #151622 #a9b5d5 #484e50 #5f676a

# 音量调节
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume 0 +2%
bindsym Ctrl+Alt+0 exec pactl set-sink-volume 0 +2%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume 0 -2%
bindsym Ctrl+Alt+9 exec pactl set-sink-volume 0 -2%
bindsym XF86AudioMute exec pactl set-sink-mute 0 toggle
bindsym Ctrl+Alt+8 exec pactl set-sink-mute 0 toggle

# 背光调节
bindsym XF86MonBrightnessUp exec brightnessctl s 10+
bindsym Ctrl+Alt+Shift+0 exec brightnessctl s 10+
bindsym XF86MonBrightnessDown exec brightnessctl s 10-
bindsym Ctrl+Alt+Shift+9 exec brightnessctl s 10-

# 禁用触摸板
bindsym Ctrl+Alt+Shift+p exec swaymsg 'input type:touchpad events disabled'
# 启用触摸板
bindsym Ctrl+Alt+Shift+o exec swaymsg 'input type:touchpad events enabled'

# 截屏
bindsym $mod+Shift+s exec grim -g "$(slurp)"

# 颜色提取
bindsym Ctrl+Alt+p exec hyprpicker -a | wl-copy

# Pot翻译
bindsym Ctrl+Alt+t exec curl "127.0.0.1:60828/selection_translate"

### Output 配置
output * bg /home/a6dg2uv/a6dg2uv/Wallpaper/deepsea.png fill

### 输入配置
# 可根据需要调整

### 键盘绑定
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu
floating_modifier $mod normal
for_window [app_id="pot"] floating enable, move position cursor
for_window [title="Minecraft*"] floating enable, move position center

# 刷新配置
bindsym $mod+Shift+c reload

# 退出 Sway
bindsym $mod+Shift+e exec swaynag -t warning -m '你确定要退出 Sway 吗？' -B '是, 退出 Sway' 'swaymsg exit'

# 移动焦点
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# 切换工作区
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
# 移动窗口到工作区
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# 切换布局
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad 管理
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# 调整窗口大小
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### 状态栏配置
bar {
    position top
    swaybar_command waybar
}

### 设置自启动程序并指定工作区
# 启动 Firefox 并分配到工作区 2
# assign [app_id="firefox"] workspace 2
# exec "sleep 1 && firefox"
assign [app_id="org.qutebrowser.qutebrowser"] workspace 2
exec "sleep 1 && qutebrowser"

# 启动 Alacritty 终端到工作区 1
assign [class="Alacritty"] workspace 1
exec alacritty

assign [app_id="org.prismlauncher.PrismLauncher"] workspace 3
exec "sleep 1 && prismlauncher"


# 引入其他配置
#include /etc/sway/config.d/*

input "type:touchpad" {
    tap enabled
    tap_button_map lrm
    natural_scroll enabled  # 启用自然滚动（触控板方向与手指一致）
    middle_emulation enabled  # 允许同时点击左右键模拟中键
    accel_profile adaptive  # 指针加速模式（adaptive/flat）
}

