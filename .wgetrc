# ~/.wgetrc - user configuration for wget

# 启用时间戳模式：仅下载服务器上较新版本的文件，节省流量
timestamping = on

# 避免 wget 递归下载时进入上级目录
no_parent = on

# 设置超时时间（秒），适用于 DNS、连接和读取等操作
timeout = 60

# 最多重试次数（默认为 20）
tries = 5

# 如果连接被拒绝也尝试重试
retry_connrefused = on

# 启用服务端文件名，避免 URL 中奇怪的名字
trust_server_names = on

# 支持 HTML 中的 FTP 链接
follow_ftp = on

# 自动为 HTML 或 CSS 文件加上适当扩展名
adjust_extension = on

# 忽略 robots 协议限制（用于镜像站点等）
robots = off

# 打印 HTTP 和 FTP 的服务器响应，便于调试
server_response = on

# 模拟浏览器请求，避免被部分网站拦截
user_agent = Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:115.0) Gecko/20100101 Firefox/115.0

# 显示下载进度条，默认为 dot 形式，可以是 'bar', 'dot', 'none'
progress = bar

# 限制带宽（单位是 bytes/s，可用 k 或 m 为单位）
# limit_rate = 500k

# 下载失败后保存日志（适合批量任务）
# logfile = ~/wget.log

# 禁用证书验证（不推荐，一般用于临时跳过证书问题）
# check_certificate = off

