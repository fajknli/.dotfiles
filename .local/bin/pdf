#!/bin/sh

# Author:       fajknli
# Emial         fajknli@gmail.com
# Created Time: 2025-07-08 18:47
# Filename:     pdfs.sh

if ! command -v wmenu; then
    exit 1
fi

if ! command -v zathura; then
    exit 1
fi

pdf_dirs=$(find "$HOME"/Documents/PDFs/ -mindepth 1 -type d)

choice_dir=$(echo "$pdf_dirs" | \
wmenu -p "PDF-DIR" -M "#a0d0a0" -m "#151622" -i -l 15 \
-f "0xProto Nerd Font Regular 12" -N "#1f2032" \
-n "#a9b5d5" -S "#a0d0a0" -s "#151622")

if [ -n "$choice_dir" ]; then
    pdf_files=$(find "$choice_dir" -mindepth 1 -type f)
    choice_file=$(echo "$pdf_files" | \
    wmenu -p "PDF-FILE" -M "#a0d0a0" -m "#151622" -i -l 15 \
    -f "0xProto Nerd Font Regular 12" -N "#1f2032" \
    -n "#a9b5d5" -S "#a0d0a0" -s "#151622")

    if [ -n "$choice_file" ]; then
        zathura "$choice_file"
    fi
fi



