if ! command -v wmenu >/dev/null 2>&1; then
    echo "wmenu is not install!" >&2
    notify-send -u critical "There is no [wmenu]"
    exit 1
fi

choice="$(printf '%s' "$countries" |\
    grep -v '^$' |\
    wmenu -i -l 15 -f "0xProto Nerd Font Regular 12" \
    -N "#1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

choice_city="$(echo $choice | awk '{print $3}')"

# 缓存文件路径
cache_dir="$HOME/.cache/weather"
cache_file="$cache_dir/wttr"

# 确保缓存目录存在
mkdir -p "$cache_dir"

# 获取天气数据(无论缓存是否存在都获取新数据)
weather="$(curl -s \
"wttr.in/$choice_city?format=%l:+%c+%C+%f++%w" 2>/dev/null)"

if [ -n "$weather" ]; then
    printf '%s' "$weather" > "$cache_file"
    notify-send "$weather"
else
    if [ -f "$cache_file" ]; then
        weather="$(cat "$cache_file")"
        notify-send "[cache] $weather"
    else
        notify-send "Can not get the weather even in cache"
    fi
fi
