#!/bin/sh
# Author:        fajknli
# Created Time:  2026-04-10
# Description:   笔记选择工具，支持 MkDocs Markdown 文件

# 选择笔记目录（docs 下的子目录）
note_dirs=$(find "$HOME/Documents/Notes/docs" -mindepth 1 -maxdepth 1 -type d)

choose_dir="$(echo "$note_dirs" | \
    wmenu -p "Director Choose" -M "#a0d0a0" -m "#151622" -i -l 12 \
    -f "0xProto Nerd Font Regular 12" \
    -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

if [ -z "$choose_dir" ]; then
    exit 1
fi

note_files=$(find "$choose_dir" -type f -name "*.md" 2>/dev/null)
# 查找所有 .md 文件（排除 index.md）
#note_files=$(find "$choose_dir" -type f -name "*.md" ! -name "index.md" 2>/dev/null)

if [ -z "$note_files" ]; then
    exit 1
fi

choice_file="$(echo "$note_files" | \
    wmenu -p "File Choose" -M "#a0d0a0" -m "#151622" -i -l 12 \
    -f "0xProto Nerd Font Regular 12" \
    -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

if [ -n "$choice_file" ]; then
    foot nvim "$choice_file"
fi
