#    choice_file="$(echo "$note_files" | \
#            wmenu -p "reST_files" -M "#a0d0a0" -m "#151622" -i -l 12 \
#            -f "0xProto Nerd Font Regular 12" \
#            -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"
#    if [ -n "$choice_file" ]; then
#        foot nvim "$choice_file"
#    fi
#else
#    exit 1
#fi

