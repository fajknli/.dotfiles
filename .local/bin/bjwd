#file=$(find $HOME/notes/notes_rst/source -type f -name "*.rst" 2>/dev/null | fzf --delimiter="/" --nth=-1 --with-nth=-1 --reverse --border --preview 'cat {}')


note_dirs=$(find "$HOME"/Documents/Notes -mindepth 1 -maxdepth 1 -type d)

choose_dir="$(echo "$note_dirs" | \
    wmenu -p "Director Choose" -M "#a0d0a0" -m "#151622" -i -l 12 \
    -f "0xProto Nerd Font Regular 12" \
    -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

if [ -z "$choose_dir" ]; then
    exit 1
fi

note_choose=$(find "$choose_dir"/source -mindepth 1 -type f | grep -v '_static')


if [ -n "$note_dirs" ]; then
    choice_file="$(echo "$note_choose" | \
        wmenu -p "File Choose" -M "#a0d0a0" -m "#151622" -i -l 12 \
        -f "0xProto Nerd Font Regular 12" \
        -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"
    if [ -n "$choice_file" ]; then
        foot nvim "$choice_file"
    fi
else
    exit 1
fi

#note_files=$(find "$choice_dir" -type f)
