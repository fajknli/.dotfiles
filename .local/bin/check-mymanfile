#!/bin/sh

# Author:       fajknli
# Emial         fajknli@gmail.com
# Created Time: 2025-08-09 12:35
# Filename:     check-mymanfile


if [ ! -d "$HOME"/.local/share/man ]; then
    for i in $(seq 1 9); do
        mkdir "$HOME"/.local/share/man/man"$i"
    done
fi

# This for Bash
# [ ! -d "$HOME/.local/share/man" ] && mkdir -p "$HOME"/.local/share/man/man{1..9}

man_dir=$(find "$HOME"/.local/share/man -mindepth 1 -type d | \
    wmenu -p "man_dirs" -M "#a0d0a0" -m "#151622" -i -l 12 \
    -f "0xProto Nerd Font Regular 12" \
    -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622"
)

if [ -n "$man_dir" ]; then
    man_file=$(find "$man_dir" -type f | \
    wmenu -p "man_files" -M "#a0d0a0" -m "#151622" -i -l 12 \
    -f "0xProto Nerd Font Regular 12" \
    -N "1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622"
    )
fi

if [ -n "$man_file" ]; then
    man "$man_file"
fi
