#!/bin/sh

if ! command -v foot; then
    echo "There no command foot" >&2
    notify-send "There no command foot"
    exit 1
fi

bin=$(find "$HOME"/.local/bin -type f)
fcitx5=$(find "$HOME"/.config/fcitx5 -type f)
lf=$(find "$HOME"/.config/lf -type f)
foot=$(find "$HOME"/.config/foot -type f)
mc=$(find "$HOME"/.config/mc -type f)
gtk=$(find "$HOME"/.config/gtk-3.0 -type f)
kitty=$(find "$HOME"/.config/kitty -type f)
niri=$(find "$HOME"/.config/niri -type f)
fuzzel=$(find "$HOME"/.config/fuzzel -type f)
htop=$(find "$HOME"/.config/htop -type f)
hypr=$(find "$HOME"/.config/hypr -type f)
waybar=$(find "$HOME"/.config/waybar -type f)
mako=$(find "$HOME"/.config/mako -type f)
zathura=$(find "$HOME"/.config/zathura -type f)
qutebrowser=$(find "$HOME"/.config/qutebrowser -type f)
nvim=$(find "$HOME"/.config/nvim -type f)
sway=$(find "$HOME"/.config/sway -type f)
zellij=$(find "$HOME"/.config/zellij -type f)
bash=$(find . -maxdepth 1 -type f -name "$HOME/.bash_*" \
    -exec find {} \;)

file_list="
$bin
$fcitx5
$foot
$gtk
$fuzzel
$htop
$mako
$sway
$zathura
$lf
$hypr
$kitty
$zellij
$mc
$niri
$nvim
$waybar
$qutebrowser
$bash
$HOME/.bashrc
$HOME/.inputrc
$HOME/.gitconfig
$HOME/.wgetrc
$HOME/.curlrc
$HOME/.alacritty
"


choice="$(printf '%s' "$file_list" | grep -v '^$' | \
    wmenu -i -l 15 -f"0xProto Nerd Font Regular 12" -N \
    "#1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

if [ -n "$choice" ]; then
    if [ -f "$choice" ]; then
        foot nvim "$choice"
#    elif [ -d "$choice" ]; then
#        if [ "$(ls -A "$choice" 2>/dev/null)" ]; then
        # this is for printf which have * and do not want show itself
        # turn on nullglob THIS IS FOR BASH ONLY
        # shopt -s nullglob
#        choice="$(printf '%s' "$choice" | grep -v '^$' | \
#            wmenu -i -l 15 -f"0xProto Nerd Font Regular 12" -N \
#            "#1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"
        # turn off nullglob
        # shopt -u nullglob
#        else
#            echo "Director is empty"
#            notify-send "Director is empty"
#        fi
    else
         echo "The path has changed, plz check if the path exist"
         notify-send "The path has changed, plz check if the path exist"
    fi
fi





