#!/bin/sh

if ! command -v foot; then
    echo "There no command foot" >&2
    notify-send "There no command foot"
    exit 1
fi

bin=$(printf "%s\n" "$HOME"/.local/bin/*)
fcitx5=$(printf "%s\n" "$HOME"/.config/fcitx5/*)
lf=$(printf "%s\n" "$HOME"/.config/lf/*)
foot=$(printf "%s\n" "$HOME"/.config/foot/*)
mc=$(printf "%s\n" "$HOME"/.config/mc/*)
gtk=$(printf "%s\n" "$HOME"/.config/gtk-3.0/*)
kitty=$(printf "%s\n" "$HOME"/.config/kitty/*)
niri=$(printf "%s\n" "$HOME"/.config/niri/*)
fuzzel=$(printf "%s\n" "$HOME"/.config/fuzzel/*)
htop=$(printf "%s\n" "$HOME"/.config/htop/*)
hypr=$(printf "%s\n" "$HOME"/.config/hypr/*)
waybar=$(printf "%s\n" "$HOME"/.config/waybar/*)
mako=$(printf "%s\n" "$HOME"/.config/mako/*)
zathura=$(printf "%s\n" "$HOME"/.config/zathura/*)
qutebrowser=$(printf "%s\n" "$HOME"/.config/qutebrowser/*)
nvim=$(printf "%s\n" "$HOME"/.config/nvim/*)
sway=$(printf "%s\n" "$HOME"/.config/sway/*)
zellij=$(printf "%s\n" "$HOME"/.config/zellij/*)
bash=$(find . -maxdepth 1 -type f -name "$HOME/.bash_*" \
    -exec printf "%s\n" {} \;)

file_list="
$bin
$fcitx5
$foot
$gtk
$fuzzel
$htop
$mako
$sway
$zathura
$lf
$hypr
$kitty
$zellij
$mc
$niri
$nvim
$waybar
$qutebrowser
$bash
$HOME/.bashrc
$HOME/.inputrc
$HOME/.gitconfig
$HOME/.wgetrc
$HOME/.curlrc
$HOME/.alacritty
"


choice="$(printf '%s' "$file_list" | grep -v '^$' | \
    wmenu -i -l 15 -f"0xProto Nerd Font Regular 12" -N \
    "#1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

if [ -n "$choice" ]; then
    if [ -f "$choice" ]; then
        foot nvim "$choice"
    elif [ -d "$choice" ]; then
        if [ "$(ls -A "$choice" 2>/dev/null)" ]; then
        # this is for printf which have * and do not want show itself
        # turn on nullglob THIS IS FOR BASH ONLY
        # shopt -s nullglob
        choice="$(printf '%s' "$choice"/* | grep -v '^$' | \
            wmenu -i -l 15 -f"0xProto Nerd Font Regular 12" -N \
            "#1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"
        # turn off nullglob
        # shopt -u nullglob
        else
            echo "Director is empty"
            notify-send "Director is empty"
        fi
    else
         echo "The path has changed, plz check if the path exist"
         notify-send "The path has changed, plz check if the path exist"
    fi
fi





