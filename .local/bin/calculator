#!/bin/sh

# Author:       fajknli
# Emial         fajknli@gmail.com
# Created Time: 2025-07-06 06:08
# Filename:     calcu.sh

input=$(wmenu -p "Calculate" -M "#a0d0a0" -m "#151622" \
-i -l 15 -f "0xProto Nerd Font Regular 12" -N "#1f2032" -n \
"#a9b5d5" -S "#a0d0a0" -s "#151622" | xargs echo)

result=$(echo "$input" | bc 2>&1)

if [ $? -eq 0 ]; then
    echo "$result" | wmenu -p "Answer" -M "#a0d0a0" -m "#151622" -i -l 15 -f \
    "0xProto Nerd Font Regular 12" -N "#1f2032" -n \
    "#a9b5d5" -S "#a0d0a0" -s "#151622" | wl-copy
    notify-send "Calculation Result" "$result"
    echo "$result" | wl-copy
else
    notify-send "Calculation Error" "$result"
fi
