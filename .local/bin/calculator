#!/bin/sh

# Author:       fajknli
# Emial         fajknli@gmail.com
# Created Time: 2025-07-06 06:08

input=$(wmenu -p "Calculate" -M "#a0d0a0" -m "#151622" \
-i -f "0xProto Nerd Font Regular 12" -N "#1f2032" -n \
"#a9b5d5" -S "#a0d0a0" -s "#151622" | xargs echo)

result=$(echo "$input" | bc 2>&1)

if [ "$result" -eq 0 ]; then
    exit 1
fi

if [ $? -eq 0 ]; then
    echo "$result"| wl-copy
    notify-send "Calculation Result:" "$result"
else
    notify-send "Calculation Error:" "$result"
fi
