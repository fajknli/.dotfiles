#!/bin/sh
# ~/.local/bin/llm

MODEL_DIR="$HOME/Public/ai/models"

# 选择模式
MODE=$(printf "server\ncli" | wmenu -p "Select Mode" -M "#a0d0a0" -m "#151622" -i -l 5 \
    -f "0xProto Nerd Font Regular 12" -N "#1f2032" -n "#a9b5d5" \
    -S "#a0d0a0" -s "#151622")

if [ -z "$MODE" ]; then
    exit 1
fi

# 选择模型
MODEL=$(find "$MODEL_DIR" -type f -name "*.gguf" ! -name "mmproj*" 2>/dev/null | \
    wmenu -p "Select GGUF Model" -M "#a0d0a0" -m "#151622" -i -l 15 \
    -f "0xProto Nerd Font Regular 12" -N "#1f2032" -n "#a9b5d5" \
    -S "#a0d0a0" -s "#151622")

if [ -z "$MODEL" ]; then
    exit 1
fi

# 检查 mmproj 文件
MODEL_DIR_NAME=$(dirname "$MODEL")
MMPROJ=$(find "$MODEL_DIR_NAME" -type f -name "mmproj*.gguf" 2>/dev/null | head -1)

# 根据模式启动
if [ "$MODE" = "server" ]; then
    if [ -n "$MMPROJ" ]; then
        CMD="llama-server -m \"$MODEL\" --mmproj \"$MMPROJ\" --host 0.0.0.0 --port 8080 -c 8192 -t 16"
    else
        CMD="llama-server -m \"$MODEL\" --host 0.0.0.0 --port 8080 -c 4096 -t 16"
    fi
    foot sh -c "$CMD; echo ''; read -p 'Press Enter to exit'"
else
    # CLI 模式
    if [ -n "$MMPROJ" ]; then
        # 有视觉模型（CLI 模式视觉不太方便，但可以支持）
        foot sh -c "llama-cli -m \"$MODEL\" --mmproj \"$MMPROJ\" --color -i -r 'User:' -f 'User: ' -c 4096 -t 16"
    else
        foot sh -c "llama-cli -m \"$MODEL\" --color -i -r 'User:' -f 'User: ' -c 4096 -t 16"
    fi
fi
