#!/bin/sh

site_lists="
mynote|file:///home/fajknli/Documents/Notes/notes_rst/build/html/index.html
deepseek|https://chat.deepseek.com/
nvim|https://neovim.io
dockerdoc|https://docs.docker.com
mygithub|https://github.com/fajknli
unixchad|https://github.com/gnuunixchad
mcwiki|https://zh.minecraft.wiki/?search=
archwiki|https://wiki.archlinux.org/index.php?search=
color|https://colorhexa.com
stardict|https://web.archive.org/web/20200702000038/http://download.huzheng.org/
achiveorg|https://web.archive.org/
fedoradoc|https://docs.fedoraproject.org/en-US/docs/
feishu|https://www.feishu.cn/
youtube|https://youtube.com/
bilibili|https://www.bilibili.com/
douyin|https://www.douyin.com/
chunkbase|https://www.chunkbase.com/
seedmap|https://mcseedmap.net/
wyyyy|https://music.163.com/
wyyyyapi|https://163api.qijieya.cn/
"

if ! command -v wmenu >/dev/null 2>&1; then
    echo "wmenu is not install!" >&2
    notify-send -u critical "There is no [wmenu]"
    exit 1
elif ! command -v qutebrowser >/dev/null 2>&1; then
    echo "firefox is not install!" >&2
    notify-send -u critical "There is no [firefox]"
    exit 1
fi

choice="$(printf '%s' "$site_lists" | grep -v '^$' | wmenu -i -l 15 -f "0xProto Nerd Font Regular 12" -N "#1f2032" -n "#a9b5d5" -S "#a0d0a0" -s "#151622")"

# Here,the $choice is only matched once and then it will quit the case sentence
# so don't worry about twice match in case
if [ -n "$choice" ]; then
    case "$choice" in
        *"|"*)
            site="$(printf '%s' "$choice" | awk -F '|' '{print $2}')"
            #qutebrowser "$site"
            $BROWSER "$site"
            ;;
        *)
    #        encoded_query="$(printf '%s' "$choice" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/?/%3F/g' -e 's/&/%26/g' -e 's/=/%3D/g')"
    #        it is not working
            #qutebrowser "https://cn.bing.com/search?q=$choice"
            $BROWSER "https://cn.bing.com/search?q=$choice"
            ;;
    esac
fi
#fi
