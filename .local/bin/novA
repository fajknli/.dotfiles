#!/bin/sh
# Author:        fajknli
# Created Time:  2025-06-30 01:36

source "$HOME"/.local/lib/shell/network/determine_global_network_connectivity.sh

sudo systemctl stop dae

sudo systemctl disable dae

state="$(systemctl is-active dae.service)"

if [ "$state" = "active" ]; then
    echo "dae is already active"
    exit 1
fi
echo "stop dae..."


sudo rm /etc/sysctl.conf && echo "sudo rm /etc/sysctl.conf"

sudo rm -r /etc/dae && echo "sudo rm -r /etc/dae"

sudo rm -r /usr/local/share/dae && echo "sudo rm -r /usr/local/share/dae"

if is_global_network; then
    printf '\033[1;32mYou are in global network\033[0m\n'
else
    printf '\033[1;31mYou are not in global network\033[0m\n'
fi

