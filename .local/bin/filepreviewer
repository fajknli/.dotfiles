#!/bin/sh

# Author:       fajknli,but original auther is gnunixchad
# Emial         fajknli@gmail.com
# Created Time: 2025-07-21 06:52
# Filename:     filepreviewer

mkdir -p "$HOME"/.cache/lf


way_to_open() {
    if [ -n "$FZF_LEVEL" ] || [ -n "$NVIM" ]; then
        catimg -t -w 80 "$1" # use catimg when running with `fzf` & `lf.vim`
    elif [ "$XDG_SESSION_TYPE" != "tty" ]; then
        chafa -f sixel -s "$2x$3" --animate off --polite on -t 1 --bg '#111111' "$1"
    else
        # catimg is faster than chafa for ANSI
        catimg -t -w "$2" "$1"
    fi
}

make_cache_file() {
    lf_filepath=$(cd $(dirname -- "$1") && pwd -P)/$(basename -- "$1")
    lf_inode=$(ls -i -- $lf_filepath | cut -d' ' -f1)
    #lf_inode=$(stat -c "%s%n%Y" -- $lf_filepath | cut -d' ' -f1)
    echo "$HOME/.cache/lf/$(echo $lf_inode$lf_filepath | sha1sum | cut -d' ' -f1)"
}


case "$(file -Lb --mime-type -- "$1")" in
    image/*)
        way_to_open "$1" "$2" "$3"
        ;;
    video/*)
        CACHE=$(make_cache_file "$1")
        [ ! -f "${CACHE}.jpg" ] && /usr/bin/ffmpegthumbnailer -i "$1" -s \
            480 -q 5 -o "${CACHE}.jpg"
        way_to_open "${CACHE}.jpg" "$2" "$3"
        ;;
    application/pdf)
        CACHE=$(make_cache_file "$1")
        [ ! -f "${CACHE}.jpg" ] && pdftoppm -jpeg -singlefile "$1" "$CACHE"
        way_to_open "${CACHE}.jpg" "$2" "$3"
        ;;
    application/zip)
        #zipinfo "$1" | "$PAGER"
        #tar -tzf "$1"
        zipinfo "$1"
        ;;
    application/gzip)
        tar -tzf "$1"
        ;;
    application/*tar|application/*zip*|application/zstd|application/*xz)
        tar vvtf "$1" | "$PAGER"
        ;;
    application/*opendocument*)
        odt2txt "$1";
        ;;
    text/html)
        w3m "$1"
        ;;
    text/*)
        bat --color always --style="plain" "$1"
        cat "$1"
        ;;
#    audio/*)
#        mid3v2 -l "$1"
#        ;;
esac
